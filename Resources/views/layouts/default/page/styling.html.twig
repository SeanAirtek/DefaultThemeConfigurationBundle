{% block _dtc_styles_global_main_element_widget %}
    <style>
        {% if headerFooterBgColor %}
            .page-header,
            .page-header .btn:not(.btn--inverse, .btn--outlined-inverse, .search-widget__input-btn, .btn--plain),
            .page-footer
            {
                background-color: {{ headerFooterBgColor }} !important;
            }

            .page-header .btn:not(.search-widget__input-btn, .btn--plain),
            .copyright
            {
                border-color: {{ headerFooterBgColor }} !important;
            }

            .page-header .btn--inverse
            {
                color: {{ headerFooterBgColor }} !important;
            }
        {% endif %}

        {% if headerFooterTextColor %}
            .page-header,
            .page-header .search-widget__input,
            .page-header .search-widget__input::placeholder,
            .page-header .btn:not(.btn--inverse, .btn--outlined-inverse),
            .page-header a:not(.dropdown-item, .shopping-list-dropdown__link),
            .page-header span.main-menu__text-label,
            .page-footer,
            .page-footer h3,
            .page-footer h6,
            .page-footer a,
            .page-footer span,
            .copyright
            {
                color: {{ headerFooterTextColor }} !important;
            }

            .page-header .btn--inverse
            {
                background-color: {{ headerFooterTextColor }} !important;
            }

            .page-header .btn--outlined-inverse,
            .page-header .search-widget__input-btn,
            .page-header .search-widget__input
            {
                border-color: {{ headerFooterTextColor }} !important;
            }
        {% endif %}

        {% if tableHeaderBgColor %}
            .table thead th,
            .product-prices__table .product-prices__th,
            .checkout-order-summary__grid .checkout-order-summary__grid-th,
            .oro-grid-table thead th,
            .cms-page table thead th
            {
                background-color: {{ tableHeaderBgColor }} !important;
            }

            .table thead th,
            .oro-grid-table thead th
            {
                border-color: {{ tableHeaderBgColor }} !important;
            }

            .product-prices
            {
                background: none;
            }
        {% endif %}

        {% if tableHeaderTextColor %}
            .table thead th,
            .table thead th .grid-header-cell__link,
            .product-prices__table .product-prices__th,
            .checkout-order-summary__grid .checkout-order-summary__grid-th,
            .oro-grid-table thead th,
            .cms-page table thead th
            {
                color: {{ tableHeaderTextColor }} !important;
            }
        {% endif %}
    </style>
{% endblock %}

{% block _dtc_styles_global_secondary_element_widget %}
    <style>
        {% if iconBgColor %}
            .badge,
            .theme-icon,
            .checkout-navigation__icon--current,
            .checkout-navigation__icon--complete,
            .cart-list-empty__icon
            {
                background-color: {{ iconBgColor }} !important;
            }

            .catalog-switcher .btn.active,
            .catalog-switcher .btn:not(.disabled):active,
            .product-item__sku-value,
            .customer-line-items__sku-value
            {
                color: {{ iconBgColor }} !important;
            }
        {% endif %}

        {% if iconContentColor %}
            .badge,
            .theme-icon,
            .checkout-navigation__icon--current,
            .checkout-navigation__icon--complete,
            .cart-list-empty__icon
            {
                color: {{ iconContentColor }} !important;
            }

            svg.theme-icon
            {
                fill: {{ iconContentColor }} !important;
            }
        {% endif %}

        {% if formBgColor %}
            .address-form,
            .customer_user_form .form-group .grid,
            .request-form-container,
            .request-form-editline,
            .request-form-editnote,
            .order-checkout-widget__container,
            .checkout,
            .checkout-order-summary-container,
            .order-review-options,
            .quick-order,
            .contact-us-form,
            .quick-order-import__container,
            .login-form,
            .register-form,
            .forgot-password-form,
            .reset-password-form,
            .check-email,
            .order-checkout-widget__container-wrapper
            {
                background-color: {{ formBgColor }} !important;
            }

            .quick-order-import__container,
            .request-form-editnote
            {
                filter: brightness(95%);
            }
        {% endif %}

        {% if linkColor %}
            a,
            a:hover,
            a:active,
            .link,
            .link:hover,
            .link:active,
            .product-item__title a,
            .product-item__title a:hover,
            .product-item__title a:active,
            .btn--link,
            .btn--link:hover,
            .btn--link:active,
            .btn--link.active,
            .btn--link:not(.disabled):active,
            .btn--link:not(.disabled).active,
            .collapse-view__trigger,
            .product-price__value,
            .order-checkout-widget__total-price,
            .shopping-list-dropdown__info,
            .shopping-lists-units__actions
            {
                color: {{ linkColor }};
            }

            .custom-radio__input:checked ~ .custom-radio__text:before,
            .custom-radio__control:checked ~ .custom-radio__text:before,
            .custom-checkbox__input:checked ~ .custom-checkbox__icon
            {
                background-color: {{ linkColor }} !important;
            }
        {% endif %}
    </style>
{% endblock %}

{% block _dtc_styles_global_menu_widget %}
    <style>
        {% if mainMenuBgColor %}
            .main-menu-outer,
            .header-row__trigger,
            .page-sidebar .shopping-list
            {
                background-color: {{ mainMenuBgColor }} !important;
            }

            .header-row
            {
                border-color: {{ mainMenuBgColor }} !important;
            }
        {% endif %}

        {% if mainMenuTextColor %}
            .main-menu__text-label,
            .main-menu-outer a,
            .main-menu-outer p,
            .page-sidebar .shopping-list a
            {
                color: {{ mainMenuTextColor }} !important;
            }
        {% endif %}

        {% if secondaryMenuBgColor %}
            .header-row__wrapper,
            .shopping-list-dropdown__item,
            .header-row__dropdown-footer button
            {
                border-color: {{ secondaryMenuBgColor }} !important;
            }

            .main-menu-column:before
            {
                border-left-color: {{ secondaryMenuBgColor }} !important;
            }

            .main-menu__item:hover,
            .shopping-list-widget .nav-trigger:hover,
            .shopping-list-widget .main-menu__item,
            .header-row__dropdown-footer button,
            .primary-menu-container
            {
                background-color: {{ secondaryMenuBgColor }} !important;
            }

            @media (max-width: 1099px) {
                .nav-trigger .main-menu__item--nested
                {
                    background-color: transparent !important;
                }
            }
        {% endif %}

        {% if secondaryMenuTextColor %}
            .shopping-list-widget .nav-trigger:hover,
            .shopping-list-widget .main-menu__item,
            .header-row__dropdown-footer button,
            .primary-menu-container h2,
            .primary-menu-container a
            {
                color: {{ secondaryMenuTextColor }} !important;
            }
        {% endif %}
    </style>
{% endblock %}

{% block _dtc_styles_global_button_widget %}
    <style>
        {% if mainButtonBgColor %}
            .btn:not(.btn--text, .btn--flat, .btn--plain, .btn--outlined, .btn--outlined-inverse, .btn--inverse, .btn--destructive-outlined, .btn--neutral-dark, .btn--destructive),
            .promo-slider__info a[href]
            {
                background-color: {{ mainButtonBgColor }} !important;
            }

            .btn:not(.btn--text, .btn--flat, .btn--plain, .btn--inverse, .btn--outlined-inverse, .btn--destructive-outlined, .btn--neutral-dark, .btn--destructive),
            .promo-slider__info a[href]
            {
                border-color: {{ mainButtonBgColor }} !important;
            }

            label.required em,
            .btn--outlined:not(.btn--destructive-outlined, .btn--neutral-dark),
            .btn--inverse:not(.btn--destructive-outlined, .btn--neutral-dark),
            .required-label
            {
                color: {{ mainButtonBgColor }} !important;
            }
        {% endif %}

        {% if mainButtonTextColor %}
            .btn--inverse:not(.btn--destructive-outlined, .btn--neutral-dark)
            {
                background-color: {{ mainButtonTextColor }} !important;
            }

            .btn:not(.btn--outlined, .btn--inverse, .btn--destructive-outlined, .btn--neutral-dark, .btn--destructive, .btn--flat, .btn--plain),
            .promo-slider__info a[href]
            {
                color: {{ mainButtonTextColor }} !important;
            }

            .btn:not(.btn--text, .btn--flat, .btn--plain).btn--outlined-inverse,
            .btn:not(.btn--text, .btn--flat, .btn--plain).btn--inverse
            {
                border-color: {{ mainButtonTextColor }} !important;
            }

            .btn-group .btn:not(.btn--outlined, .btn--text, .btn--flat, .btn--plain).dropdown-toggle
            {
                border-left-color: {{ mainButtonTextColor }} !important;
            }
        {% endif %}

        {% if secondaryButtonBgColor %}
            .btn--text:not(.btn--outlined, .btn--outlined-inverse, .btn--inverse, .btn--destructive-outlined, .btn--neutral-dark, .btn--destructive, .btn--flat, .btn--plain)
            {
                background-color: {{ secondaryButtonBgColor }} !important;
            }

            .btn--text:not(.btn--no-padding, .btn--outlined-inverse, .btn--inverse, .btn--destructive-outlined, .btn--neutral-dark, .btn--destructive, .input-quantity-btn, .product-price-hint-btn, .prices-hint-toggler, .dropdown-toggle, .action, .product-tier-prices, .btn--flat, .btn--plain),
            .product-item__qty-input
            {
                border-color: {{ secondaryButtonBgColor }} !important;
            }

            .btn--text.btn--outlined:not(.btn--destructive-outlined, .btn--neutral-dark),
            .btn--text.btn--inverse:not(.btn--destructive-outlined, .btn--neutral-dark)
            {
                color: {{ secondaryButtonBgColor }} !important;
            }
        {% endif %}

        {% if secondaryButtonTextColor %}
            .btn--text.btn--inverse:not(.btn--destructive-outlined, .btn--neutral-dark, .btn--flat, .btn--plain)
            {
                background-color: {{ secondaryButtonTextColor }} !important;
            }

            .btn--text:not(.btn--outlined, .btn--inverse, .btn--destructive-outlined, .btn--neutral-dark)
            {
                color: {{ secondaryButtonTextColor }} !important;
            }

            .btn--text.btn--outlined-inverse:not(.btn--destructive-outlined, .btn--neutral-dark, .btn--destructive, .btn--flat, .btn--plain),
            .btn--text.btn--inverse:not(.btn--destructive-outlined, .btn--neutral-dark, .btn--destructive, .btn--flat, .btn--plain)
            {
                border-color: {{ secondaryButtonTextColor }} !important;
            }
        {% endif %}

            .btn:not(.btn--destructive-outlined, .btn--neutral-dark, .btn--destructive):disabled
            {
                filter: opacity(75%);
            }
    </style>
{% endblock %}

{% block _dtc_styles_global_additional_widget %}
    <style>
        {% set supportedFontFamilies = {
            'georgia'         : 'Georgia, serif',
            'palatino'        : '"Palatino Linotype", "Book Antiqua", Palatino, serif',
            'times'           : '"Times New Roman", Times, serif',
            'arial'           : 'Arial, Helvetica, sans-serif',
            'arial-black'     : '"Arial Black", Gadget, sans-serif',
            'comic-sans'      : '"Comic Sans MS", cursive, sans-serif',
            'impact'          : 'Impact, Charcoal, sans-serif',
            'lucida'          : '"Lucida Sans Unicode", "Lucida Grande", sans-serif',
            'tahoma'          : 'Tahoma, Geneva, sans-serif',
            'trebuchet'       : '"Trebuchet MS", Helvetica, sans-serif',
            'verdana'         : 'Verdana, Geneva, sans-serif',
            'courier'         : '"Courier New", Courier, monospace',
            'lucida-console'  : '"Lucida Console", Monaco, monospace'
        } %}

        {% set resolvedFontFamily = null %}
        {% if customFontFamily %}
            {% set resolvedFontFamily = customFontFamily %}
        {% elseif fontFamily and supportedFontFamilies[fontFamily] %}
            {% set resolvedFontFamily = supportedFontFamilies[fontFamily] %}
        {% endif %}

        {% if resolvedFontFamily %}
            .body,
            h1,
            h2,
            h3,
            h4,
            h5,
            h6,
            button,
            input,
            textarea,
            .select,
            .btn,
            .promo-slider__info a[href],
            .ui-dialog,
            .product-item__primary-content,
            .product-item__secondary-content,
            .popover-body .table,
            .grid-container .grid
            {
                font-family: {{ resolvedFontFamily|striptags|raw }} !important;
            }
        {% endif %}
    </style>

{% endblock %}

{% block _dtc_styles_global_custom_css_widget %}
    {% if customCssGlobal %}
        <style>
            {{ customCssGlobal|striptags|raw }}
        </style>
    {% endif %}
{% endblock %}
